# Phase 2 Template - Issue comments only
# This template should replace claude-for-github.yml content after Phase 1 success
name: Claude for GitHub

on:
  workflow_dispatch:
    inputs:
      test_mode:
        description: 'Test mode for claude-for-github.yml restoration'
        required: false
        default: 'phase2_test'
        type: string
  issue_comment:
    types: [created]
    # Limited to issue comments only for initial testing

permissions:
  contents: write
  issues: write
  pull-requests: write

jobs:
  claude:
    runs-on: ubuntu-latest
    steps:
      - name: Claude for GitHub (Phase 2)
        uses: anthropics/claude-code-action@v0.0.58
        with:
          github-token: ${{ secrets.GITHUB_TOKEN }}
          anthropic-api-key: ${{ secrets.ANTHROPIC_API_KEY }}
        env:
          TEST_MODE: ${{ github.event.inputs.test_mode || 'phase2_auto' }}
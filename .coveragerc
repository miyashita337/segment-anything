# KIRO-006 Phase 2 - Coverage Configuration for Workflow Plan Command System

[run]
# Source code to measure
source = tools/workflow

# Files to include in coverage
include = 
    tools/workflow/*.py
    tools/workflow/**/*.py

# Files to exclude from coverage
omit = 
    */tests/*
    */test_*.py
    */__pycache__/*
    */venv/*
    */env/*
    */.venv/*
    setup.py
    */migrations/*
    */deprecated/*

# Branch coverage
branch = True

# Parallel processing
parallel = True

# Data file location
data_file = .coverage

[report]
# Reporting options
precision = 2
show_missing = True
skip_covered = False
sort = Cover

# Exclude lines from coverage
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\bProtocol\):
    @(abc\.)?abstractmethod

# Minimum coverage percentage
fail_under = 80

[html]
# HTML report directory
directory = htmlcov

# HTML report title
title = KIRO-006 Phase 2 - Workflow Plan Command Coverage Report

[xml]
# XML report file
output = coverage.xml

[json]
# JSON report file
output = coverage.json
pretty_print = True